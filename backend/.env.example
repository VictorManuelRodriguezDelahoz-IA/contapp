# ============================================================
# SUPABASE CREDENTIALS
# ============================================================
# Obtén estas credenciales desde: Supabase Dashboard → Settings → API

SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ IMPORTANTE:
# - SUPABASE_SERVICE_ROLE_KEY es SECRETO, nunca lo expongas en frontend
# - Solo usa SERVICE_ROLE_KEY para operaciones admin (crear usuarios, etc.)

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Agrega las URLs de tu frontend (separadas por coma)

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# En producción, agrega tu dominio:
# ALLOWED_ORIGINS=https://tu-app.vercel.app,https://tu-dominio.com

